# Copy to `.env` and edit, then `set -a && source .env && set +a`.
#
# Nothing here is secret — these are the values that differ between one person's
# workspace and another's. The repository is deliberately runnable with none of
# them set except the profile: everything else has a working default.
#
# For actual credentials (none are required today — Jolpica and Open-Meteo are
# both keyless), see setup_secrets.py.

# ─── required ───────────────────────────────────────────────────────────
# Your Databricks CLI profile. There is no default and the scripts will not
# guess one; they list what you have configured and stop.
#   databricks auth profiles
#   databricks auth login --host https://<workspace>.cloud.databricks.com --profile <name>
DATABRICKS_PROFILE=

# ─── optional: where the data lives ─────────────────────────────────────
# The Unity Catalog catalog. Must already exist — Free Edition cannot create
# catalogs over the API, so make it in the UI with Default storage.
F1_CATALOG=f1

# Schema and name of the landing Volume inside that catalog.
F1_VOLUME_SCHEMA=raw
F1_VOLUME_NAME=landing

# Local directory holding backfilled JSON before it is uploaded.
F1_LOCAL_LANDING=./landing

# Bundle target: dev or prod. prod writes to a separate catalog (f1_prod) that
# you must create first.
F1_TARGET=dev

# ─── optional: bundle variables ─────────────────────────────────────────
# The bundle reads these as BUNDLE_VAR_<name>; they override databricks.yml
# defaults without editing it. Find your warehouse with:
#   databricks warehouses list --profile <name>
# BUNDLE_VAR_warehouse_id=
# BUNDLE_VAR_catalog=f1
