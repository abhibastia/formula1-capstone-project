{
  "datasets": [
    {
      "name": "ds_pace",
      "displayName": "Race pace per driver",
      "queryLines": [
        "WITH ranked AS (\n",
        "  SELECT season, round, race_date, race_name, circuit_name,\n",
        "         driver_id, driver_name,\n",
        "         constructor_name_as_of_race AS team,\n",
        "         laps_recorded, clean_laps, laps_led,\n",
        "         median_clean_lap_s, best_lap_s, consistency_s,\n",
        "         reference_median_s, pace_deficit_pct,\n",
        "         grid_position, finish_position, positions_gained, dnf_flag,\n",
        "         RANK() OVER (PARTITION BY season, round ORDER BY median_clean_lap_s) AS pace_rank\n",
        "  FROM lap_pace\n",
        ")\n",
        "SELECT ranked.*,\n",
        "       finish_position - pace_rank AS result_vs_pace,\n",
        "       CASE WHEN dnf_flag                         THEN 'retired'\n",
        "            WHEN finish_position - pace_rank >= 3 THEN 'finished behind pace'\n",
        "            WHEN finish_position - pace_rank <= -3 THEN 'finished ahead of pace'\n",
        "            ELSE 'finished on pace' END AS pace_verdict\n",
        "FROM ranked\n"
      ]
    },
    {
      "name": "ds_pace_driver",
      "displayName": "Driver pace summary",
      "queryLines": [
        "SELECT season, driver_name,\n",
        "       constructor_name_as_of_race AS team,\n",
        "       COUNT(*)                            AS races,\n",
        "       ROUND(AVG(pace_deficit_pct), 3)     AS avg_pace_deficit_pct,\n",
        "       ROUND(MIN(best_lap_s), 3)           AS best_lap_s,\n",
        "       ROUND(AVG(consistency_s), 3)        AS avg_consistency_s,\n",
        "       SUM(laps_led)                       AS laps_led,\n",
        "       ROUND(AVG(finish_position), 2)      AS avg_finish,\n",
        "       SUM(CASE WHEN dnf_flag THEN 1 ELSE 0 END) AS dnfs\n",
        "FROM lap_pace\n",
        "GROUP BY season, driver_name, constructor_name_as_of_race\n"
      ]
    },
    {
      "name": "ds_reliability",
      "displayName": "Reliability by constructor",
      "queryLines": [
        "SELECT season,\n",
        "       constructor_name_as_of_race AS team,\n",
        "       COUNT(*)                                  AS starts,\n",
        "       SUM(CASE WHEN dnf_flag THEN 1 ELSE 0 END) AS dnfs,\n",
        "       ROUND(100.0 * AVG(CASE WHEN dnf_flag THEN 1.0 ELSE 0.0 END), 1) AS dnf_rate_pct,\n",
        "       SUM(total_points)                         AS points,\n",
        "       ROUND(AVG(finish_position), 2)            AS avg_finish,\n",
        "       SUM(CASE WHEN is_win THEN 1 ELSE 0 END)   AS wins\n",
        "FROM driver_performance\n",
        "WHERE constructor_name_as_of_race IS NOT NULL\n",
        "GROUP BY season, constructor_name_as_of_race\n"
      ]
    },
    {
      "name": "ds_retirement_reason",
      "displayName": "Why cars stopped",
      "queryLines": [
        "SELECT season,\n",
        "       constructor_name_as_of_race AS team,\n",
        "       status,\n",
        "       COUNT(*) AS retirements\n",
        "FROM driver_performance\n",
        "WHERE dnf_flag AND constructor_name_as_of_race IS NOT NULL\n",
        "GROUP BY season, constructor_name_as_of_race, status\n"
      ]
    }
  ],
