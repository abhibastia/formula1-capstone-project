# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment
.venv/

# Harvested API payloads.
#
# Regenerated by `ingest.py` and uploaded to the UC Volume, which is where the
# pipeline actually reads them from. Several hundred files and the largest thing
# in the tree by far — and reproducible from the API, so committing it would
# trade repository size for nothing.
landing/

# Databricks CLI bundle state: deployment ids and sync snapshots, specific to
# one workspace and one user.
.databricks/

# Local environment overrides. `.env.example` is the committed template; the
# copy holds one person's profile and workspace.
.env

# Editors and OS
.idea/
.vscode/
.DS_Store

# Generated presentation output. The deck is rebuilt from
# docs/deck/build_deck.py; the .pptx itself is a build artefact.
build/

# Scratch
scratchpad.txt
